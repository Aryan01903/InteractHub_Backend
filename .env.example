# ──────────────────────────────────────────────────────────────────────────────
# InteractHub API
#
# Parsed and validated once at boot by src/config/env.ts. A missing or malformed
# required value fails the process immediately with a precise message rather
# than surfacing much later as an opaque runtime error.
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000
HOST=0.0.0.0
LOG_LEVEL=info

# ─── Required ─────────────────────────────────────────────────────────────────
DB_URL=mongodb+srv://user:password@cluster.mongodb.net/interacthub

# Minimum 32 characters. Rotating this invalidates every existing session.
SECRET=replace-me-with-at-least-32-random-characters

# ─── Frontend / CORS ──────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
# Extra allowed origins, comma-separated. localhost:3000, 127.0.0.1:3000 and the
# Vercel deployments are always permitted.
CORS_ORIGINS=

ACCESS_TOKEN_TTL=7d

# ─── Rate limiting ────────────────────────────────────────────────────────────
# The global ceiling. Auth and upload routes apply much tighter per-route budgets.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# ─── Mail ─────────────────────────────────────────────────────────────────────
# Optional: without credentials the API still boots and every flow completes,
# but outbound mail is logged instead of sent.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
BREVO_MAIL=
BREVO_SMTP_KEY=
MAIL_USER=
MAIL_PASS=
RESEND_API_KEY=
MAIL_FROM=InteractHub <no-reply@yourdomain.com>

# ─── Cloudinary ───────────────────────────────────────────────────────────────
# Server-side only. Attachments are uploaded through the API so the folder is
# derived from the caller's verified organization and the secret never reaches
# a browser.
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# ─── WebRTC TURN relay ────────────────────────────────────────────────────────
# Optional but strongly recommended: STUN alone fails behind symmetric NAT,
# which covers most corporate networks. Handed to clients by GET /api/calls/:id
# only after membership is verified, so the credential is never public.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Password gate for the /admin contact inbox. Unset disables the console.
ADMIN_PASSWORD=

# Brevo transactional email. The HTTP API is used when API_KEY + SENDER are set;
# it avoids an SMTP handshake per message. SMTP below is the fallback.
BREVO_API_KEY=
BREVO_SENDER=
BREVO_SENDER_NAME=InteractHub
