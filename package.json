{
  "name": "interacthub-backend",
  "version": "2.0.0",
  "description": "InteractHub \u2014 Multi-Tenant RBAC Real-Time Collaboration Platform (Fastify + TypeScript)",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "migrate": "tsx src/scripts/migrate.ts",
    "test": "tsx src/scripts/smoke.ts && tsx src/scripts/bootcheck.ts",
    "smoke": "tsx src/scripts/smoke.ts",
    "bootcheck": "tsx src/scripts/bootcheck.ts",
    "preflight": "tsx src/scripts/preflight.ts",
    "verify:migration": "tsx src/scripts/verify-migration.ts"
  },
  "author": "Aryan Kumar Shrivastav",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/sensible": "^6.0.3",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "mongoose": "^8.15.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.6",
    "pino": "^9.14.0",
    "resend": "^6.12.4",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "mongodb-memory-server": "^10.4.3",
    "pino-pretty": "^13.0.0",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
